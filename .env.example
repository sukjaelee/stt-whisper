# OpenAI settings
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_CORRECTION_MODEL=gpt-5.4-mini
OPENAI_CORRECTION_MAX_CHARS=6000
OPENAI_CORRECTION_PROMPT_FILE=prompts/direct_correction_default.md

# GCP launcher defaults
GCP_PROJECT_ID=your-gcp-project-id
GCP_ZONE=your-gcp-zone
GCP_SERVICE_ACCOUNT=your-service-account@your-gcp-project-id.iam.gserviceaccount.com
GCP_INPUT_BUCKET=your-input-bucket
GCP_OUTPUT_BUCKET=your-output-bucket
GCP_STAGING_BUCKET=your-staging-bucket
GCP_IMAGE_FAMILY=stt-whisper-cu128
GCP_IMAGE_PROJECT=your-image-project
GCP_WHISPER_MODEL_PATH=/opt/stt-whisper-models/large-v3
GCP_TRANSCRIBE_PRESET=high_quality
GCP_OPENAI_API_KEY_SECRET=projects/your-gcp-project-id/secrets/openai-api-key/versions/latest
GCP_SKIP_CORRECTION=true
GCP_WAIT=true
GCP_DOWNLOAD_DIR=data
GCP_CLEAR_JOB_OBJECTS=true
